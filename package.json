{
  "name": "spider-web",
  "private": true,
  "type": "module",
  "description": "Local screen maps and visual change review for web apps",
  "scripts": {
    "spider": "tsx src/cli.ts",
    "dev": "SPIDER_DEV=1 tsx src/cli.ts serve",
    "crawl": "tsx src/cli.ts crawl",
    "review": "tsx src/cli.ts review",
    "build": "vite build --config viewer/vite.config.ts",
    "types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pixelmatch": "7.1.0",
    "playwright": "1.57.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@types/node": "22.19.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@xyflow/react": "12.10.0",
    "lucide-react": "0.561.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "7.2.7"
  },
  "bin": {
    "spider-web": "bin/spider-web.js"
  }
}
