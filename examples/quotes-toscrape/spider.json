{
  "$schema": "../../src/spider.schema.json",
  "name": "Quotes to Scrape",
  "baseURL": "https://quotes.toscrape.com",
  "viewports": [
    { "id": "desktop", "width": 1280, "height": 800 },
    { "id": "mobile", "width": 390, "height": 844 }
  ],
  "colorSchemes": ["light"],
  "maxScreens": 15,
  "personas": {
    "visitor": {
      "seeds": ["/"],
      "exclude": ["/js/**", "/scroll", "/tableful/**", "/random"]
    },
    "member": {
      "seeds": ["/"],
      "exclude": ["/login", "/logout", "/js/**", "/scroll", "/tableful/**", "/random"],
      "login": [
        { "goto": "/login" },
        { "fill": { "css": "#username" }, "value": "demo" },
        { "fill": { "css": "#password" }, "value": "demo" },
        { "click": { "role": "button", "name": "Login" } },
        { "waitFor": { "text": "Logout" } }
      ]
    }
  },
  "routes": {
    "preset": "sitemap",
    "extra": ["/page/:page", "/author/:name", "/tag/:tag", "/tag/:tag/page/:page"]
  },
  "params": { "page": "2", "name": "Albert-Einstein", "tag": "love" }
}
