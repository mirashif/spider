{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "verbatimModuleSyntax": false,
    "paths": {
      "@contracts": [
        "./src/contracts.ts"
      ]
    }
  },
  "include": [
    "src",
    "viewer",
    "examples",
    "test"
  ]
}
